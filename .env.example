# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# VITE_SUPABASE_URL: URL do seu projeto Supabase (ex.: https://xyzproject.supabase.co)
VITE_SUPABASE_URL="http://127.0.0.1:54321"

# VITE_SUPABASE_ANON_KEY: Chave pública anon do Supabase (para autenticação e queries seguras via RLS)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0"

# ============================================================================
# MÓDULO DE NEWSLETTER — SEGREDOS DAS EDGE FUNCTIONS
# ============================================================================
# Estes valores NÃO entram no bundle do front-end. São configurados no runtime
# das Edge Functions, nunca em arquivo versionado:
#
#   supabase secrets set NEWSLETTER_WORKER_SECRET="..." NEWSLETTER_TOKEN_SECRET="..." ...
#
# As credenciais de provedor (Resend, SMTP, ...) também ficam fora do banco:
# public.newsletter_providers guarda apenas o NOME da variável, no campo
# secret_ref. Abaixo, como referência de operação, estão somente os nomes.
#
# NEWSLETTER_WORKER_SECRET     Autentica o worker disparado por pg_cron.
# NEWSLETTER_TOKEN_SECRET      Assina tokens de clique/abertura (HMAC-SHA256).
#                              Se ausente, usa a service role key como chave.
# NEWSLETTER_PUBLIC_URL        URL pública usada em pixels, links e descadastro.
# NEWSLETTER_TIMEZONE          Fuso da janela de envio (padrão America/Sao_Paulo).
# RESEND_API_KEY               Credencial do provedor referenciada em secret_ref.
# RESEND_WEBHOOK_SECRET        Segredo Svix (whsec_...) para validar o webhook.
#
# NEWSLETTER_WORKER_SECRET=""
# NEWSLETTER_TOKEN_SECRET=""
# NEWSLETTER_PUBLIC_URL=""
# NEWSLETTER_TIMEZONE="America/Sao_Paulo"
# RESEND_API_KEY=""
# RESEND_WEBHOOK_SECRET=""
